<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="ccs_online_session.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Pending online queues must not replay from an automatic device transfer. -->
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="ccs_online_session.xml" />
    </device-transfer>
</data-extraction-rules>

